# Скопируйте в intake/.env (в git не коммитить)
DATABASE_URL=postgresql+psycopg://medscreen:CHANGE_ME@localhost:5432/medscreen
DEID_URL=http://localhost:8001
# = SERVICE_API_KEY из .env обезличивания
DEID_API_KEY=
# python -c "import secrets; print(secrets.token_urlsafe(48))"  — хранить отдельно от БД; потеря = данные не расшифровать
DATA_MASTER_KEY=
# адреса фронтенда через запятую (пусто — CORS выключен), напр. http://localhost:5173
CORS_ORIGINS=
WORKER_POLL_SECONDS=1.0
WORKER_STALE_SECONDS=900
